{
  "schema_version": 2,
  "detected_stacks": [
    "python",
    "node"
  ],
  "package_manager": "npm",
  "commands": {
    "install": [
      "python -m pip install \"jsonschema>=4.23,<5\"",
      "npm install"
    ],
    "format_check": [],
    "lint": [
      "python -m py_compile scripts/validate_content.py scripts/validate_phase_b.py scripts/audit_phase_c.py scripts/validate_prd.py"
    ],
    "typecheck": [
      "npm run typecheck"
    ],
    "unit_tests": [
      "python scripts/validate_content.py",
      "python scripts/validate_phase_b.py",
      "python scripts/audit_phase_c.py --check-report",
      "python scripts/validate_prd.py",
      "npm run test"
    ],
    "integration_tests": [
      "python scripts/validate_content.py --private ."
    ],
    "build": [
      "npm run build"
    ],
    "e2e": []
  },
  "sonar": {
    "internal_private_loc_limit": 45000
  },
  "zap": {
    "manual_only": true
  }
}
