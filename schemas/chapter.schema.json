{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "French Grammar Quest — Chapter Metadata v1",
  "type": "object",
  "required": [
    "chapter",
    "title",
    "source",
    "topics",
    "exercise_ids",
    "question_total",
    "validation"
  ],
  "properties": {
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "pdf_pages",
        "answer_key_pdf_pages",
        "source_sha256"
      ],
      "properties": {
        "pdf_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "answer_key_pdf_pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "exercise_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ch[0-9]{2}-t[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "exercise_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exercise_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ch[0-9]{2}-ex[0-9]{2}$"
      }
    },
    "question_total": {
      "type": "integer",
      "minimum": 1
    },
    "validation": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
