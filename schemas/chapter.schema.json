{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "French Grammar Chapter Metadata",
  "type": "object",
  "required": [
    "chapter",
    "title",
    "pdf_pages",
    "topics",
    "exercise_ids",
    "validation"
  ],
  "properties": {
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "pdf_pages": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "exercise_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
