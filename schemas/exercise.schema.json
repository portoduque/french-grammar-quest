{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "French Grammar Quest — Exercise Collection v1",
  "type": "object",
  "required": [
    "chapter",
    "status",
    "exercises"
  ],
  "properties": {
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 28
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "topic_ids",
          "instruction",
          "interaction_type",
          "questions",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ch[0-9]{2}-ex[0-9]{2}$"
          },
          "source": {
            "type": "object",
            "required": [
              "chapter",
              "exercise",
              "pdf_pages"
            ],
            "properties": {
              "chapter": {
                "type": "integer",
                "minimum": 1,
                "maximum": 28
              },
              "exercise": {
                "type": "string",
                "minLength": 3
              },
              "pdf_pages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "additionalProperties": false
          },
          "topic_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^ch[0-9]{2}-t[0-9]{2}$"
            }
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "interaction_type": {
            "type": "string",
            "enum": [
              "fill_blank",
              "translation",
              "matching",
              "sentence_rewrite",
              "free_response",
              "ordering",
              "multiple_choice",
              "other"
            ]
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "number",
                "prompt",
                "source_raw_prompt",
                "pdf_pages",
                "answer"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^ch[0-9]{2}-ex[0-9]{2}-q[0-9]{2,3}$"
                },
                "number": {
                  "type": "integer",
                  "minimum": 1
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "source_raw_prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "pdf_pages": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "answer": {
                  "type": "object",
                  "required": [
                    "source_key",
                    "accepted",
                    "review_status"
                  ],
                  "properties": {
                    "source_key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "accepted": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "review_status": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                "parallel_option": {
                  "type": "object",
                  "required": [
                    "label",
                    "text"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "validation": {
            "type": "object",
            "required": [
              "question_count",
              "source_partition_checked",
              "answer_key_aligned",
              "manual_visual_review"
            ],
            "properties": {
              "question_count": {
                "type": "integer",
                "minimum": 1
              },
              "source_partition_checked": {
                "type": "boolean"
              },
              "answer_key_aligned": {
                "type": "boolean"
              },
              "manual_visual_review": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
